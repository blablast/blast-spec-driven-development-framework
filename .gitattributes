# blast — line ending normalization
# Repo stores LF for text files. Working tree gets LF unless user sets core.autocrlf=true.
# This eliminates the spurious CRLF/LF diffs caused by Windows OneDrive sync.

* text=auto eol=lf

# Windows-native scripts must keep CRLF in working tree to execute correctly
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp3   binary
*.mp4   binary
*.webm  binary

# Lockfiles / generated — keep LF, don't merge as text
package-lock.json   text eol=lf -diff
yarn.lock           text eol=lf -diff
pnpm-lock.yaml      text eol=lf -diff
poetry.lock         text eol=lf -diff
Pipfile.lock        text eol=lf -diff
