{
  "_comment": "blast framework — OPTIONAL MCP servers. Merge the entries you want into the 'mcpServers' object of your existing .mcp.json (or register user-scope via `claude mcp add` to keep your root clean). 'blast-llm-bridge' = local Ollama bridge (qwen3-coder / qwen3.6) for local code-gen + critics. 'semble' = fast local code search for agents (~98% fewer tokens than grep+read; requires uv). Both are opt-in — without them blast still works cloud-only and falls back to grep.",
  "mcpServers": {
    "blast-llm-bridge": {
      "command": "python",
      "args": [
        ".claude/mcp/blast-llm-bridge.py"
      ],
      "env": {
        "BLAST_OLLAMA_UBUNTU": "http://192.168.5.60:11434",
        "BLAST_LLM_TIMEOUT_S": "240"
      }
    },
    "semble": {
      "command": "uvx",
      "args": ["--from", "semble[mcp]", "semble"]
    }
  }
}
